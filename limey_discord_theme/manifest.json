{
  "manifest_version": 3,
  "name": "Limey Captcha Alert Theme",
  "version": "1.4.0",
  "description": "Styles captcha-alert messages as dark red auth-screen alert boxes in Discord. Only the Limey bot and WEBHOOK-tagged authors that post captcha alerts are flagged (never humans or other bots); can be locked to a single webhook. Pure client-side CSS — no data is read or sent anywhere.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://*.discord.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["https://discord.com/*", "https://*.discord.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Limey Captcha Alert Theme",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "limey-discord-theme@local",
      "strict_min_version": "109.0"
    }
  }
}
